# Environment / secrets
.env
.env.*
!.env.example
config/local.php

# Dependencies
/vendor/
/node_modules/

# Uploads & user content
/public/uploads/*
!/public/uploads/.gitkeep

# Logs & cache
*.log
/storage/logs/*
/storage/cache/*
.cache/

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Database dumps
*.sql.gz
/database/dumps/

# Uploaded documents — PII, never committed
/storage/app/*
!/storage/app/documents/
/storage/app/documents/*
!/storage/app/documents/.gitkeep
