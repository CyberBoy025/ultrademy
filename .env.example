APP_NAME=Ultrademy
APP_ENV=local
APP_DEBUG=true
# Base URL of the app — note there is NO /public on the end. The root .htaccess maps
# /ultrademymain/ onto public/ internally, so the folder never appears in a URL.
#
# Leave both of these blank (or delete the lines) and the app works it out from
# DOCUMENT_ROOT, which is usually what you want on a local XAMPP install: rename the
# folder and nothing needs editing. Set them explicitly for staging and production,
# where the filesystem no longer tells the truth about the public URL.
APP_URL=http://localhost/ultrademymain
# Careers portal base URL — path-based today, a real subdomain once the vhost cutover
# happens (docs/architecture/16-careers-portal.md §14). Change this one value when it does;
# nothing in code hard-codes either form.
CAREERS_URL=http://localhost/ultrademymain/careers

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ultrademy
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
